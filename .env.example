# ===== App =====
NODE_ENV=development
PORT=3000

# ===== Database (PostgreSQL) =====
# Local Docker Compose defaults — override in prod
DB_HOST=localhost
DB_PORT=5432
DB_USER=geest
DB_PASSWORD=geest
DB_NAME=geest
DB_SSL=false

# Alternative: single URL (Render sets DATABASE_URL automatically)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ===== Notifications =====
# External URL that will receive task-archived events
NOTIFY_URL=https://webhook.site/your-uuid-here
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_INITIAL_BACKOFF_MS=500

# ===== Idempotency =====
# TTL in seconds for stored idempotency keys (default 24h)
IDEMPOTENCY_TTL_SECONDS=86400
